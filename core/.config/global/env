#!/usr/bin/env zsh

export STOW_FOLDERS="bin,core,nvim,tmux,zsh,ghostty,asdf"

change_background() {
    dconf write /org/mate/desktop/background/picture-filename "'$HOME/dotfiles/backgrounds/$(ls ~/dotfiles/backgrounds | fzf)'"
}

die () {
    echo >&2 "$@"
    exit 1
}

addToPath() {
    if [[ "$PATH" != *"$1"* ]]; then
        export PATH=$PATH:$1
    fi
}

addToPathFront() {
    if [[ "$PATH" != *"$1"* ]]; then
        export PATH=$1:$PATH
    fi
}

commitDotFiles() {
    pushd $DOTFILES
    pushd personal
    git add .
    git commit -m "update"
    git push origin main
    popd
    git add .
    git commit -m "update"
    git push origin master
    popd
}

killport() {
    lsof -i tcp:$1 | awk 'NR!=1 {print $2}' | xargs kill -9
}

mci() {
  if [[ "$1" == "--no-tests" ]] || [[ "$1" == "-nt" ]]; then
    mvn fmt:format && mvn clean install -Dmaven.test.skip=true
  else
    mvn fmt:format && mvn clean install -DskipITs=true -Dit.skip=true -Dskip.it.tests=true
  fi
}